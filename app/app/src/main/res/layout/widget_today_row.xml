<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/row_time"
        style="@style/WidgetText.SemiBold"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="1:00 PM"
        android:textColor="@color/widget_text_soft"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/row_title"
        style="@style/WidgetText.SemiBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="IT102 - Mobile Application Development"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/row_room"
        style="@style/WidgetText.Regular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxEms="7"
        android:maxLines="1"
        android:text="Room 204"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />
</LinearLayout>
